{
  "name": "vibe-chat-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend for the Vibe chat application (gendered matching chat, coins, rooms, games)",
  "main": "src/server.js",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node src/database/seeders/index.js",
    "sync-indexes": "node scripts/sync-indexes.js",
    "db": "node scripts/dev-db.js",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "multer": "^2.2.0",
    "nanoid": "^5.0.8",
    "nodemailer": "^9.0.6",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "razorpay": "^2.9.5",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.14.0",
    "mongodb-memory-server": "^10.1.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
