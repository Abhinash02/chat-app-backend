# =============================================================================
# Vibe Chat — backend configuration
#
# Copy to `.env` and fill in. Only the REQUIRED block is needed to start; every
# optional service degrades to something sensible when its keys are blank, so
# you can add them one at a time as you need them.
#
# The app validates this file at boot and refuses to start on a bad value — a
# missing secret is a startup failure, not a surprise at 2am.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — the app will not start without these
# -----------------------------------------------------------------------------

# Any MongoDB. Three ways to get one:
#   local     `npm run db`  (uses the binary the test suite already downloads)
#   docker    docker run -d -p 27017:27017 -v vibe-mongo:/data/db --name vibe-mongo mongo:7
#   hosted    https://cloud.mongodb.com  →  free M0 cluster  →  Connect  →  Drivers
#
# An Atlas string looks like:
#   mongodb+srv://user:password@cluster0.abcde.mongodb.net/vibechat?retryWrites=true&w=majority
# Remember to allow your server's IP under Atlas → Network Access.
MONGODB_URI=mongodb://127.0.0.1:27017/vibechat

# Two DIFFERENT random strings, 32+ characters each. Not a service — generate them:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing either one signs everybody out. Never commit the real values.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Which browser origins may call the API. The mobile app is not a browser and
# does not belong here. Use exact origins in production, never "*".
#   local        http://localhost:5173
#   production   https://admin.yourapp.com,https://yourapp.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8082

# Public origin of THIS server. Used to build unsubscribe links in campaign
# email, so those links must work from someone's inbox.
#   production   https://api.yourapp.com
PUBLIC_API_URL=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12


# -----------------------------------------------------------------------------
# Email — OPTIONAL, but nobody can sign up in production without it
#
# This sends verification codes, password resets and campaigns.
# Leave SMTP_HOST empty and codes are printed to the server log instead, which
# is fine locally and useless in production.
#
# Where to get SMTP credentials (any provider works):
#   Brevo    https://www.brevo.com          300 free emails/day  — good default
#   Resend   https://resend.com             3,000 free/month
#   Gmail    myaccount.google.com/apppasswords  — an APP PASSWORD, not your
#            login password, and only after 2FA is on. Fine for testing, poor
#            for bulk sending: Google will throttle campaigns.
#
# Brevo example:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your-login@smtp-brevo.com
#   SMTP_PASSWORD=your-smtp-key
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# The From address. Use a domain you control and have verified with the
# provider, or your mail lands in spam.
MAIL_FROM_NAME=Vibe Chat
MAIL_FROM_EMAIL=no-reply@vibechat.app


# -----------------------------------------------------------------------------
# Storage — where profile photos go
#
#   local       writes to ./uploads. No account needed. Files are lost when a
#               container restarts, so this is development only.
#   supabase    1 GB free.  https://supabase.com  →  new project
#               Settings → API           gives the URL and service_role key
#               Storage → New bucket     name it, and mark it PUBLIC
#   cloudinary  25 GB free. https://cloudinary.com  →  Dashboard shows all three
#               values. Resizes images for you, which supabase does not.
#
# Only fill in the provider you chose. The service_role key bypasses row-level
# security — it is a server secret and must never reach the app or the panel.
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vibechat-media

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vibechat


# -----------------------------------------------------------------------------
# Payments — OPTIONAL
#
# Leave these blank and the app runs in UPI-only mode: users pay your UPI ID
# from any payment app and you confirm the transfer in the admin panel. That
# needs no keys at all — set your UPI ID under Admin → Settings → Payments.
#
# For automatic card/UPI checkout:
#   https://dashboard.razorpay.com  →  Account & Settings  →  API Keys
#   Test keys start rzp_test_, live keys rzp_live_. Live keys need KYC.
#
# The webhook secret is a string YOU choose when adding the webhook:
#   Dashboard → Webhooks → Add
#   URL     https://api.yourapp.com/webhooks/razorpay
#   Events  payment.captured, order.paid
# It is what proves a payment notification really came from Razorpay, so
# without it no order is ever credited automatically.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Bootstrap admin — created by `npm run seed`
#
# Only used on first run; re-seeding never overwrites an existing account, so
# changing these later does nothing. Change the password from inside the panel.
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@vibechat.app
SEED_ADMIN_PASSWORD=Admin@12345
